# ============================================================
# Agentic Workbench – Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- GitHub Copilot (required for Chat & MCP) -------------
# Personal Access Token with Copilot access
GITHUB_TOKEN=ghp_your_github_token_here

# --- Google Gemini API (for LangChain RAG) ----------------
# Gemini API Key (e.g. from https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- GitHub MCP Server (optional – for Repo Assistant) ---
# Same token is used for MCP; override here if different
GITHUB_MCP_TOKEN=

# --- Local Embedding model (fallback) ---------------------
# Local HuggingFace model id for FAISS embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Copilot model (optional) ----------------------------
COPILOT_MODEL=gpt-4o

# --- App settings ----------------------------------------
APP_TITLE=Agentic Workbench
DATA_DIR=data
