# ============================================================
# Agentic Workbench – Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- GitHub Copilot (required for Chat, Repo Assistant & Reviewer) ---
# Personal Access Token with Copilot access
GITHUB_TOKEN=ghp_your_github_token_here

# --- GitHub MCP Server (optional – override if different) ---
GITHUB_MCP_TOKEN=

# --- Copilot model (optional) ----------------------------
COPILOT_MODEL=gpt-4o

# --- App settings ----------------------------------------
APP_TITLE=Agentic Workbench
DATA_DIR=data
